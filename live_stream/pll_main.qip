set_global_assignment -name IP_TOOL_NAME "ALTPLL"
set_global_assignment -name IP_TOOL_VERSION "25.1"
set_global_assignment -name IP_GENERATED_DEVICE_FAMILY "{MAX 10}"
set_global_assignment -name VHDL_FILE [file join $::quartus(qip_path) "pll_main.vhd"]
set_global_assignment -name MISC_FILE [file join $::quartus(qip_path) "pll_main_inst.vhd"]
set_global_assignment -name MISC_FILE [file join $::quartus(qip_path) "pll_main.cmp"]
set_global_assignment -name MISC_FILE [file join $::quartus(qip_path) "pll_main.ppf"]
