# =============================================================================
# stream_top.qsf
# Quartus Settings File — DE10-Lite (MAX10 10M50DAF484C7G)
# OV7670 -> SDRAM -> VGA real-time streaming
# =============================================================================

set_global_assignment -name FAMILY "MAX 10"
set_global_assignment -name DEVICE 10M50DAF484C7G
set_global_assignment -name TOP_LEVEL_ENTITY stream_top
set_global_assignment -name LAST_QUARTUS_VERSION "25.1std.0 SP0.02std Lite Edition"

# =============================================================================
# Source files — compilation order matters (leaves first, top last)
# =============================================================================
set_global_assignment -name VHDL_FILE vga_subsystem/asyn_fifo.vhd
set_global_assignment -name VHDL_FILE sys_ctrl/debounce_explicit.vhd
set_global_assignment -name VHDL_FILE camera_subsystem/i2c_top.vhd
set_global_assignment -name VHDL_FILE camera_subsystem/camera_interface.vhd
set_global_assignment -name VHDL_FILE sdram_subsystem/sdram_controller.vhd
set_global_assignment -name VHDL_FILE sdram_subsystem/sdram_interface.vhd
set_global_assignment -name VHDL_FILE vga_subsystem/vga_core.vhd
set_global_assignment -name VHDL_FILE vga_subsystem/vga_interface.vhd
set_global_assignment -name VHDL_FILE pll_main.vhd
set_global_assignment -name VHDL_FILE sys_ctrl/sys_ctrl.vhd
set_global_assignment -name VHDL_FILE camera_subsystem/camera_subsystem.vhd
set_global_assignment -name VHDL_FILE sdram_subsystem/sdram_subsystem.vhd
set_global_assignment -name VHDL_FILE vga_subsystem/vga_subsystem.vhd
set_global_assignment -name VHDL_FILE stream_top.vhd

# =============================================================================
# Clock — 50 MHz
# =============================================================================
set_location_assignment PIN_P11 -to MAX10_CLK1_50
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to MAX10_CLK1_50

# =============================================================================
# Push buttons (active low)
# =============================================================================
set_location_assignment PIN_B8  -to KEY[0]
set_location_assignment PIN_A7  -to KEY[1]
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to KEY[0]
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to KEY[1]

# =============================================================================
# LEDs
# =============================================================================
set_location_assignment PIN_A8  -to LEDR[0]
set_location_assignment PIN_A9  -to LEDR[1]
set_location_assignment PIN_A10 -to LEDR[2]
set_location_assignment PIN_B10 -to LEDR[3]
set_location_assignment PIN_D13 -to LEDR[4]
set_location_assignment PIN_C13 -to LEDR[5]
set_location_assignment PIN_E14 -to LEDR[6]
set_location_assignment PIN_D14 -to LEDR[7]
set_location_assignment PIN_A11 -to LEDR[8]
set_location_assignment PIN_B11 -to LEDR[9]
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to LEDR[*]

# =============================================================================
# VGA connector
# =============================================================================
set_location_assignment PIN_N3   -to VGA_HS
set_location_assignment PIN_N1   -to VGA_VS
set_location_assignment PIN_AA1  -to VGA_R[0]
set_location_assignment PIN_V1   -to VGA_R[1]
set_location_assignment PIN_Y2   -to VGA_R[2]
set_location_assignment PIN_Y1   -to VGA_R[3]
set_location_assignment PIN_W1   -to VGA_G[0]
set_location_assignment PIN_T2   -to VGA_G[1]
set_location_assignment PIN_R2   -to VGA_G[2]
set_location_assignment PIN_R1   -to VGA_G[3]
set_location_assignment PIN_P1   -to VGA_B[0]
set_location_assignment PIN_T1   -to VGA_B[1]
set_location_assignment PIN_P4   -to VGA_B[2]
set_location_assignment PIN_N2   -to VGA_B[3]
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to VGA_R[*]
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to VGA_G[*]
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to VGA_B[*]
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to VGA_HS
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to VGA_VS

# =============================================================================
# SDRAM — IS42S16320F onboard
# =============================================================================
set_location_assignment PIN_L14  -to DRAM_CLK
set_location_assignment PIN_N22  -to DRAM_CKE
set_location_assignment PIN_U20  -to DRAM_CS_N
set_location_assignment PIN_U22  -to DRAM_RAS_N
set_location_assignment PIN_U21  -to DRAM_CAS_N
set_location_assignment PIN_V20  -to DRAM_WE_N
set_location_assignment PIN_T21  -to DRAM_BA[0]
set_location_assignment PIN_T22  -to DRAM_BA[1]
set_location_assignment PIN_U17  -to DRAM_ADDR[0]
set_location_assignment PIN_W19  -to DRAM_ADDR[1]
set_location_assignment PIN_V18  -to DRAM_ADDR[2]
set_location_assignment PIN_U18  -to DRAM_ADDR[3]
set_location_assignment PIN_U19  -to DRAM_ADDR[4]
set_location_assignment PIN_T18  -to DRAM_ADDR[5]
set_location_assignment PIN_T19  -to DRAM_ADDR[6]
set_location_assignment PIN_R18  -to DRAM_ADDR[7]
set_location_assignment PIN_P18  -to DRAM_ADDR[8]
set_location_assignment PIN_P19  -to DRAM_ADDR[9]
set_location_assignment PIN_T20  -to DRAM_ADDR[10]
set_location_assignment PIN_P20  -to DRAM_ADDR[11]
set_location_assignment PIN_R20  -to DRAM_ADDR[12]
set_location_assignment PIN_J21  -to DRAM_UDQM
set_location_assignment PIN_V22  -to DRAM_LDQM
set_location_assignment PIN_Y21  -to DRAM_DQ[0]
set_location_assignment PIN_Y20  -to DRAM_DQ[1]
set_location_assignment PIN_AA22 -to DRAM_DQ[2]
set_location_assignment PIN_AA21 -to DRAM_DQ[3]
set_location_assignment PIN_Y22  -to DRAM_DQ[4]
set_location_assignment PIN_W22  -to DRAM_DQ[5]
set_location_assignment PIN_W20  -to DRAM_DQ[6]
set_location_assignment PIN_V21  -to DRAM_DQ[7]
set_location_assignment PIN_P21  -to DRAM_DQ[8]
set_location_assignment PIN_J22  -to DRAM_DQ[9]
set_location_assignment PIN_H21  -to DRAM_DQ[10]
set_location_assignment PIN_H22  -to DRAM_DQ[11]
set_location_assignment PIN_G22  -to DRAM_DQ[12]
set_location_assignment PIN_G20  -to DRAM_DQ[13]
set_location_assignment PIN_G19  -to DRAM_DQ[14]
set_location_assignment PIN_F22  -to DRAM_DQ[15]
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to DRAM_*

# =============================================================================
# OV7670 camera on GPIO_0 (JP1 header)
# Pin mapping assumes the following physical wiring:
#   GPIO_0[0..7]  -> D[0..7]
#   GPIO_0[8]     -> PCLK
#   GPIO_0[9]     -> HREF
#   GPIO_0[10]    -> VSYNC
#   GPIO_0[11]    -> XCLK
#   GPIO_0[12]    -> SIOC
#   GPIO_0[13]    -> SIOD
#   GPIO_0[14]    -> RESET_N
#   GPIO_0[15]    -> PWDN
# Verify against your physical wire-up before compiling
# =============================================================================
set_location_assignment PIN_V10  -to OV7670_D[0]
set_location_assignment PIN_W10  -to OV7670_D[1]
set_location_assignment PIN_V9   -to OV7670_D[2]
set_location_assignment PIN_W9   -to OV7670_D[3]
set_location_assignment PIN_V8   -to OV7670_D[4]
set_location_assignment PIN_W8   -to OV7670_D[5]
set_location_assignment PIN_V7   -to OV7670_D[6]
set_location_assignment PIN_W7   -to OV7670_D[7]
set_location_assignment PIN_W6   -to OV7670_PCLK
set_location_assignment PIN_V5   -to OV7670_HREF
set_location_assignment PIN_W5   -to OV7670_VSYNC
set_location_assignment PIN_AA15 -to OV7670_XCLK
set_location_assignment PIN_AA14 -to OV7670_SIOC
set_location_assignment PIN_W13  -to OV7670_SIOD
set_location_assignment PIN_W12  -to OV7670_RESET_N
set_location_assignment PIN_AB13 -to OV7670_PWDN
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to OV7670_*

# Timing constraints should be in an SDC file, not the QSF.
# The QSF is just for project settings.
# Ensure SDC file is included (already checked below)
# =============================================================================

# Fitter
# =============================================================================
set_global_assignment -name FITTER_EFFORT "STANDARD FIT"
set_global_assignment -name PHYSICAL_SYNTHESIS_EFFORT "NORMAL"
set_global_assignment -name SEED 1
set_global_assignment -name ALLOW_REGISTER_RETIMING ON



set_location_assignment PIN_C10 -to SW[0]
set_location_assignment PIN_C11 -to SW[1]
set_location_assignment PIN_D12 -to SW[2]
set_location_assignment PIN_C12 -to SW[3]
set_location_assignment PIN_A12 -to SW[4]
set_location_assignment PIN_B12 -to SW[5]
set_location_assignment PIN_A13 -to SW[6]
set_location_assignment PIN_A14 -to SW[7]
set_location_assignment PIN_B14 -to SW[8]
set_location_assignment PIN_F15 -to SW[9]
